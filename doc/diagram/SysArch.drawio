        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n    %% =========================\n    %% CLIENT LAYER\n    %% =========================\n    subgraph CLIENT[\&quot;Client Layer\&quot;]\n        C1[\&quot;Client User\&quot;]\n        C2[\&quot;Freelancer User\&quot;]\n        C3[\&quot;Admin User\&quot;]\n    end\n\n    %% =========================\n    %% API / PRESENTATION LAYER\n    %% =========================\n    subgraph API[\&quot;API Layer - Spring Boot REST API\&quot;]\n        A1[\&quot;Authentication &amp; Authorization\&quot;]\n        A2[\&quot;User / Profile Management\&quot;]\n        A3[\&quot;Project Management\&quot;]\n        A4[\&quot;Proposal Management\&quot;]\n        A5[\&quot;Contract / Hiring Management\&quot;]\n        A6[\&quot;Review &amp; Rating Management\&quot;]\n        A7[\&quot;Notification Management\&quot;]\n        A8[\&quot;Report Management\&quot;]\n        A9[\&quot;Admin Management\&quot;]\n    end\n\n    %% =========================\n    %% SECURITY\n    %% =========================\n    subgraph SECURITY[\&quot;Security Layer\&quot;]\n        S1[\&quot;Spring Security\&quot;]\n        S2[\&quot;JWT Authentication\&quot;]\n        S3[\&quot;Role Based Access Control\&quot;]\n    end\n\n    %% =========================\n    %% BUSINESS LAYER\n    %% =========================\n    subgraph SERVICE[\&quot;Business Logic Layer\&quot;]\n        B1[\&quot;User Service\&quot;]\n        B2[\&quot;Freelancer Service\&quot;]\n        B3[\&quot;Project Service\&quot;]\n        B4[\&quot;Proposal Service\&quot;]\n        B5[\&quot;Contract Service\&quot;]\n        B6[\&quot;Review Service\&quot;]\n        B7[\&quot;Notification Service\&quot;]\n        B8[\&quot;Report Service\&quot;]\n        B9[\&quot;Admin Service\&quot;]\n    end\n\n    %% =========================\n    %% DATA ACCESS LAYER\n    %% =========================\n    subgraph DAL[\&quot;Data Access Layer\&quot;]\n        D1[\&quot;Spring Data JPA\&quot;]\n        D2[\&quot;Hibernate ORM\&quot;]\n        D3[\&quot;Repository Layer\&quot;]\n    end\n\n    %% =========================\n    %% DATABASE\n    %% =========================\n    subgraph DB[\&quot;Database Layer\&quot;]\n        DB1[(\&quot;MySQL Database\&quot;)]\n        T1[\&quot;Users\&quot;]\n        T2[\&quot;Freelancer Profiles\&quot;]\n        T3[\&quot;Skills\&quot;]\n        T4[\&quot;Projects\&quot;]\n        T5[\&quot;Proposals\&quot;]\n        T6[\&quot;Contracts\&quot;]\n        T7[\&quot;Reviews\&quot;]\n        T8[\&quot;Notifications\&quot;]\n        T9[\&quot;Reports\&quot;]\n    end\n\n    %% =========================\n    %% DOCUMENTATION / TESTING\n    %% =========================\n    subgraph DEV[\&quot;Development &amp; Testing Tools\&quot;]\n        P[\&quot;Postman\&quot;]\n        SW[\&quot;Swagger / OpenAPI\&quot;]\n        G[\&quot;Git / GitHub\&quot;]\n        M[\&quot;Maven\&quot;]\n    end\n\n    %% =========================\n    %% USER TO API\n    %% =========================\n    C1 --&gt; A1\n    C1 --&gt; A2\n    C1 --&gt; A3\n    C1 --&gt; A4\n    C1 --&gt; A5\n    C1 --&gt; A6\n\n    C2 --&gt; A1\n    C2 --&gt; A2\n    C2 --&gt; A3\n    C2 --&gt; A4\n    C2 --&gt; A5\n    C2 --&gt; A6\n\n    C3 --&gt; A1\n    C3 --&gt; A9\n    C3 --&gt; A8\n\n    %% =========================\n    %% API TO SECURITY\n    %% =========================\n    A1 --&gt; S1\n    A2 --&gt; S1\n    A3 --&gt; S1\n    A4 --&gt; S1\n    A5 --&gt; S1\n    A6 --&gt; S1\n    A7 --&gt; S1\n    A8 --&gt; S1\n    A9 --&gt; S1\n\n    S1 --&gt; S2\n    S1 --&gt; S3\n\n    %% =========================\n    %% API TO BUSINESS LOGIC\n    %% =========================\n    A1 --&gt; B1\n    A2 --&gt; B2\n    A3 --&gt; B3\n    A4 --&gt; B4\n    A5 --&gt; B5\n    A6 --&gt; B6\n    A7 --&gt; B7\n    A8 --&gt; B8\n    A9 --&gt; B9\n\n    %% =========================\n    %% BUSINESS TO DATA ACCESS\n    %% =========================\n    B1 --&gt; D3\n    B2 --&gt; D3\n    B3 --&gt; D3\n    B4 --&gt; D3\n    B5 --&gt; D3\n    B6 --&gt; D3\n    B7 --&gt; D3\n    B8 --&gt; D3\n    B9 --&gt; D3\n\n    D3 --&gt; D1\n    D1 --&gt; D2\n    D2 --&gt; DB1\n\n    %% =========================\n    %% DATABASE TABLES\n    %% =========================\n    DB1 --&gt; T1\n    DB1 --&gt; T2\n    DB1 --&gt; T3\n    DB1 --&gt; T4\n    DB1 --&gt; T5\n    DB1 --&gt; T6\n    DB1 --&gt; T7\n    DB1 --&gt; T8\n    DB1 --&gt; T9\n\n    %% =========================\n    %% DEVELOPMENT TOOLS\n    %% =========================\n    P -. \&quot;API Testing\&quot; .-&gt; API\n    SW -. \&quot;API Documentation\&quot; .-&gt; API\n    G -. \&quot;Version Control\&quot; .-&gt; API\n    M -. \&quot;Build\&quot; .-&gt; API\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zRsy-XZSVd2zjc5aqXS7-1">
